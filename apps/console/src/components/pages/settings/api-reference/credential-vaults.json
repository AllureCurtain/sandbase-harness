[
  {
    "id": "vaults-list",
    "group": "Credential vaults",
    "title": "List vaults",
    "method": "GET",
    "path": "/v1/credential-vaults",
    "summary": "List credential vaults and summary counts without exposing secret values.",
    "response": [
      {
        "name": "data",
        "type": "CredentialVault[]",
        "description": "Credential vault descriptors."
      }
    ]
  },
  {
    "id": "vaults-create",
    "group": "Credential vaults",
    "title": "Create vault",
    "method": "POST",
    "path": "/v1/credential-vaults",
    "summary": "Create a vault for credentials that can be mounted into sessions.",
    "parameters": [
      {
        "name": "name",
        "type": "string",
        "required": true,
        "description": "Human-readable vault name."
      },
      {
        "name": "metadata",
        "type": "object",
        "description": "Opaque tags."
      }
    ],
    "response": [
      {
        "name": "id",
        "type": "string",
        "description": "Vault identifier."
      },
      {
        "name": "vault",
        "type": "object",
        "description": "Created or updated vault resource."
      }
    ]
  },
  {
    "id": "vaults-get",
    "group": "Credential vaults",
    "title": "Get vault",
    "method": "GET",
    "path": "/v1/credential-vaults/{vault_id}",
    "summary": "Fetch a vault descriptor and safe credential summary.",
    "response": [
      {
        "name": "id",
        "type": "string",
        "description": "Vault identifier."
      },
      {
        "name": "vault",
        "type": "object",
        "description": "Created or updated vault resource."
      }
    ]
  },
  {
    "id": "vaults-credentials-list",
    "group": "Credential vaults",
    "title": "List credentials",
    "method": "GET",
    "path": "/v1/credential-vaults/{vault_id}/credentials",
    "summary": "List credentials in a vault. Secret values are always masked or omitted.",
    "response": [
      {
        "name": "data",
        "type": "Credential[]",
        "description": "Safe credential descriptors."
      }
    ]
  },
  {
    "id": "vaults-credential-create",
    "group": "Credential vaults",
    "title": "Add credential",
    "method": "POST",
    "path": "/v1/credential-vaults/{vault_id}/credentials",
    "summary": "Add an OAuth, bearer token, or environment variable credential to a workspace vault.",
    "parameters": [
      {
        "name": "auth_type",
        "type": "mcp_oauth | bearer_token | environment_variable",
        "required": true,
        "description": "Credential type and injection mode."
      },
      {
        "name": "name",
        "type": "string",
        "description": "Optional human-readable label."
      },
      {
        "name": "value",
        "type": "string",
        "description": "Secret value. Stored encrypted and never returned in list responses."
      },
      {
        "name": "network",
        "type": "object",
        "description": "Allowed hosts and access mode for this credential."
      },
      {
        "name": "injection_locations",
        "type": "array",
        "description": "Request header or body injection locations."
      }
    ],
    "response": [
      {
        "name": "id",
        "type": "string",
        "description": "Server-generated vcrd_... identifier."
      },
      {
        "name": "value_hint",
        "type": "string",
        "description": "Masked hint for the stored secret."
      },
      {
        "name": "status",
        "type": "active | archived",
        "description": "Current credential state."
      }
    ]
  },
  {
    "id": "vaults-credential-archive",
    "group": "Credential vaults",
    "title": "Archive credential",
    "method": "POST",
    "path": "/v1/credential-vaults/{vault_id}/credentials/{credential_id}/archive",
    "summary": "Archive a credential while retaining audit metadata.",
    "response": [
      {
        "name": "id",
        "type": "string",
        "description": "Credential identifier."
      },
      {
        "name": "credential",
        "type": "object",
        "description": "Created or updated credential resource."
      }
    ]
  },
  {
    "id": "vaults-credential-delete",
    "group": "Credential vaults",
    "title": "Delete credential",
    "method": "DELETE",
    "path": "/v1/credential-vaults/{vault_id}/credentials/{credential_id}",
    "summary": "Delete a credential from a vault.",
    "response": [
      {
        "name": "id",
        "type": "string",
        "description": "Credential identifier."
      },
      {
        "name": "credential",
        "type": "object",
        "description": "Created or updated credential resource."
      }
    ]
  },
  {
    "id": "vaults-archive",
    "group": "Credential vaults",
    "title": "Archive vault",
    "method": "POST",
    "path": "/v1/credential-vaults/{vault_id}/archive",
    "summary": "Archive a credential vault and remove it from active selection.",
    "response": [
      {
        "name": "id",
        "type": "string",
        "description": "Archived vault identifier."
      },
      {
        "name": "vault",
        "type": "object",
        "description": "Created or updated vault resource."
      }
    ]
  },
  {
    "id": "vaults-credential-rotate",
    "group": "Credential vaults",
    "title": "Rotate credential",
    "method": "POST",
    "path": "/v1/credential-vaults/{vault_id}/credentials/{credential_id}/rotate",
    "summary": "Replace a credential's encrypted secret value. The credential keeps its identity, policy and audit history, and the previous value is not recoverable from the row afterwards.",
    "parameters": [
      {
        "name": "vault_id",
        "type": "string",
        "required": true,
        "description": "Credential vault id."
      },
      {
        "name": "credential_id",
        "type": "string",
        "required": true,
        "description": "Credential id."
      },
      {
        "name": "value",
        "type": "string",
        "required": true,
        "description": "New secret value. An empty or missing value is refused with 400, and the stored secret is left untouched."
      },
      {
        "name": "actor",
        "type": "string",
        "description": "Optional actor recorded on the rotate audit event."
      },
      {
        "name": "metadata",
        "type": "object",
        "description": "Optional metadata recorded on the rotate audit event. Never contains the secret."
      }
    ],
    "response": [
      {
        "name": "value_hint",
        "type": "string",
        "description": "Masked hint of the new value. The secret itself is never returned."
      }
    ]
  },
  {
    "id": "vaults-credential-mark-used",
    "group": "Credential vaults",
    "title": "Mark credential used",
    "method": "POST",
    "path": "/v1/credential-vaults/{vault_id}/credentials/{credential_id}/mark-used",
    "summary": "Stamp a credential as used and append a use event to its audit trail. This is the one management call a client makes without a body.",
    "parameters": [
      {
        "name": "vault_id",
        "type": "string",
        "required": true,
        "description": "Credential vault id."
      },
      {
        "name": "credential_id",
        "type": "string",
        "required": true,
        "description": "Credential id."
      },
      {
        "name": "metadata",
        "type": "object",
        "description": "Optional metadata recorded on the use event."
      }
    ],
    "response": [
      {
        "name": "last_used_at",
        "type": "string",
        "description": "ISO 8601 timestamp of this use."
      }
    ]
  },
  {
    "id": "vaults-credential-audit",
    "group": "Credential vaults",
    "title": "List credential audit events",
    "method": "GET",
    "path": "/v1/credential-vaults/{vault_id}/credentials/{credential_id}/audit",
    "summary": "List one credential's rotation, use and runtime injection events newest first. The trail survives deletion and never contains secret material.",
    "parameters": [
      {
        "name": "vault_id",
        "type": "string",
        "required": true,
        "description": "Credential vault id."
      },
      {
        "name": "credential_id",
        "type": "string",
        "required": true,
        "description": "Credential id."
      },
      {
        "name": "limit",
        "type": "number",
        "description": "Maximum events to return. Defaults to 100 and is capped at 500."
      }
    ],
    "response": [
      {
        "name": "data",
        "type": "array",
        "description": "Audit events, newest first."
      }
    ]
  },
  {
    "id": "vaults-audit",
    "group": "Credential vaults",
    "title": "List vault audit events",
    "method": "GET",
    "path": "/v1/credential-vaults/{vault_id}/audit",
    "summary": "List every credential audit event in one vault newest first, including events for credentials that were deleted afterwards.",
    "parameters": [
      {
        "name": "vault_id",
        "type": "string",
        "required": true,
        "description": "Credential vault id."
      },
      {
        "name": "limit",
        "type": "number",
        "description": "Maximum events to return. Defaults to 100 and is capped at 500."
      }
    ],
    "response": [
      {
        "name": "data",
        "type": "array",
        "description": "Audit events for the vault, newest first."
      }
    ]
  }
]
